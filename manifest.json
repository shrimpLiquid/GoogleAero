{

	"name": "Google Aero",
	"version": "1.0.0",
	"manifest_version": 3,
	"description": "makes googles home page more fun!",
	"permissions": [
		"bookmarks",
		"favicon",
		"topSites",
		"tabs",
		"fontSettings",
		"sessions"
	],
	"icons": {
		"128": "icons/icon_128.png",
		"48": "icons/icon_48.png",
		"16": "icons/icon_16.png"
	},
	"optional_host_permissions": [
		"file:///"
	],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"options_ui": {
		"page": "newtab.html?options",
		"open_in_tab": true
	}
}
